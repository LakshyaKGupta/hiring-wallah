# Hiring Wallah Backend Environment
# Copy to backend/.env and fill locally or configure in hosting.
# Never commit real .env files.

GEMINI_API_KEY=

DATABASE_URL=

FIREBASE_PROJECT_ID=hiring-wallah-prod
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_ALLOW_LOCAL_TOKEN_FALLBACK=true

CORS_ORIGINS=http://localhost:3000
DB_FALLBACK_SQLITE=true
SQLITE_DB_PATH=hiring_wallah.db
